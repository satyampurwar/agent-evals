OPENROUTER_API_KEY=
DATABASE_URL=postgres://evals:evals@localhost:5432/evals
REDIS_URL=redis://localhost:6379
JUDGE_MODEL=openai/gpt-4.1-mini
# Host port for the Docker Postgres. Set it if 5432 is taken by a local Postgres,
# and use the same port in DATABASE_URL.
# POSTGRES_HOST_PORT=5433

# Host ports for `docker compose up --build` (Phase 13). The defaults are shown; change one only if it is in use.
# Inside the compose network the services use their own names and ports, so these never change them.
# API_HOST_PORT=3000
# WEB_HOST_PORT=5173
# REDIS_HOST_PORT=6379
# PYTHON_WORKER_HOST_PORT=8001
