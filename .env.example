OPENROUTER_API_KEY=
DATABASE_URL=postgres://evals:evals@localhost:5432/evals
REDIS_URL=redis://localhost:6379

# Host port for Docker Postgres. Set if 5432 is taken by a local Postgres,
# and use the same port in DATABASE_URL when running host-side tools.
# POSTGRES_HOST_PORT=5433

# List prices for estimatedCostUsd. Unset → prices.json at the repo root
# (/app/prices.json in the image). A model missing from the table fails trials
# before they run (price_missing).
# PRICE_TABLE_PATH=/app/prices.json

# Host ports for `docker compose up --build`. Defaults shown; change if in use.
# Inside Compose, services use service names and fixed internal ports.
# API_HOST_PORT=3000
# WEB_HOST_PORT=5173
# REDIS_HOST_PORT=6379
# PYTHON_WORKER_HOST_PORT=8001

# Cap concurrent trials in the worker (OpenRouter in-flight budget).
# TRIAL_CONCURRENCY=1
